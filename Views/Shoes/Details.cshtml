@model Routing.Models.Shoe

@{
    ViewData["Title"] = "Shoe Details";
}

<h2>Shoe Details</h2>
<div>
    <h4>@Model.Name</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            Type
        </dt>
        <dd class = "col-sm-10">
            @Model.Type
        </dd>
        <dt class = "col-sm-2">
            Color
        </dt>
        <dd class = "col-sm-10">
            @Model.Color
        </dd>
        <dt class = "col-sm-2">
            Price
        </dt>
        <dd class = "col-sm-10">
            @Model.Price.ToString("C")
        </dd>
    </dl>
    <a asp-action="Index">Back to List</a>
</div>
